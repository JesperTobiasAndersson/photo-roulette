# Copy to .env and fill in. All EXPO_PUBLIC_* values are bundled into the client,
# so never put a server secret (e.g. the Supabase service_role / secret key) in here.

# Supabase → Project Settings → API (the "publishable" or legacy "anon" key)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public address used in share links and SEO (defaults to the current site on web)
EXPO_PUBLIC_SITE_URL=

# Optional: tip link shown after a game ends (Swish link, Ko-fi, Buy Me a Coffee…). Empty = hidden.
EXPO_PUBLIC_TIP_URL=
